# ============================================================
# 企业合同智能审查与风险辅助 Agent - 环境配置示例
# 复制本文件为 .env 并按需填写
# ============================================================

# ---------- 运行模式 ----------
# true  = 使用完整 Docker 基础设施（PostgreSQL/Milvus/Neo4j/Redis/Celery）
# false = 本地降级模式（SQLite + 内存向量库），无需任何外部依赖即可运行
USE_DOCKER=false

# ---------- 应用 ----------
APP_NAME=Contract Review Agent
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret
API_PREFIX=/api

# ---------- 大模型（OpenAI 协议，兼容 DeepSeek / 通义 / vLLM 等） ----------
# 留空时自动进入 Mock 模式（内置规则引擎 + 模拟LLM，可跑通全流程）
LLM_PROVIDER=openai
LLM_API_KEY=
# 默认使用 OpenAI；使用 DeepSeek 时改成 https://api.deepseek.com
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contract_review

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------- Milvus ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=legal_knowledge_collection

# ---------- Neo4j ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ---------- 文件存储 ----------
# 可选：local / minio
STORAGE_BACKEND=local
STORAGE_DIR=../storage
